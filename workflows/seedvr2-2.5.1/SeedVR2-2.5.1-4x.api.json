{
  "1": {
    "inputs": {
      "image": "seedvr2-demo/SeedVR2-official-demo-320x478.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "01 · 上传原图"
    }
  },
  "2": {
    "inputs": {
      "model": "seedvr2_ema_3b_fp8_e4m3fn.safetensors",
      "device": "cuda:0",
      "blocks_to_swap": 32,
      "swap_io_components": true,
      "offload_device": "cpu",
      "cache_model": false,
      "attention_mode": "sdpa"
    },
    "class_type": "SeedVR2LoadDiTModel",
    "_meta": {
      "title": "DiT · 3B FP8 / CPU 卸载"
    }
  },
  "3": {
    "inputs": {
      "model": "ema_vae_fp16.safetensors",
      "device": "cuda:0",
      "encode_tiled": true,
      "encode_tile_size": 512,
      "encode_tile_overlap": 64,
      "decode_tiled": true,
      "decode_tile_size": 512,
      "decode_tile_overlap": 64,
      "tile_debug": "false",
      "offload_device": "cpu",
      "cache_model": false
    },
    "class_type": "SeedVR2LoadVAEModel",
    "_meta": {
      "title": "VAE · 分块编码与解码"
    }
  },
  "4": {
    "inputs": {
      "image": [
        "1",
        0
      ]
    },
    "class_type": "GetImageSize",
    "_meta": {
      "title": "02 · 读取原图尺寸"
    }
  },
  "5": {
    "inputs": {
      "value": true
    },
    "class_type": "PrimitiveBoolean",
    "_meta": {
      "title": "03 · 倍率：关闭 2× / 开启 4×"
    }
  },
  "6": {
    "inputs": {
      "expression": "min(a, b) * (4 if c else 2)",
      "values.a": [
        "4",
        0
      ],
      "values.b": [
        "4",
        1
      ],
      "values.c": [
        "5",
        0
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "04 · 原图短边 × 倍率"
    }
  },
  "7": {
    "inputs": {
      "seed": 42,
      "resolution": [
        "6",
        1
      ],
      "max_resolution": 0,
      "batch_size": 1,
      "uniform_batch_size": false,
      "color_correction": "lab",
      "temporal_overlap": 0,
      "prepend_frames": 0,
      "input_noise_scale": 0,
      "latent_noise_scale": 0,
      "offload_device": "cpu",
      "enable_debug": false,
      "image": [
        "1",
        0
      ],
      "dit": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "class_type": "SeedVR2VideoUpscaler",
    "_meta": {
      "title": "05 · SeedVR2 v2.5.1 高清放大"
    }
  },
  "9": {
    "inputs": {
      "filename_prefix": "canvas-upscale/SeedVR2-4x",
      "images": [
        "7",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "06 · 保存 PNG"
    }
  }
}
