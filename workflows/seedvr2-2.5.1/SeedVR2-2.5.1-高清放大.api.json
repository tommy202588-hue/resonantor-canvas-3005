{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "seedvr2-demo/SeedVR2-official-demo-320x478.png"
    },
    "_meta": {
      "title": "01 加载原图"
    }
  },
  "2": {
    "class_type": "SeedVR2LoadDiTModel",
    "inputs": {
      "model": "seedvr2_ema_3b_fp8_e4m3fn.safetensors",
      "device": "cuda:0",
      "blocks_to_swap": 32,
      "swap_io_components": true,
      "offload_device": "cpu",
      "cache_model": false,
      "attention_mode": "sdpa"
    },
    "_meta": {
      "title": "02 SeedVR2 3B FP8 · CPU卸载"
    }
  },
  "3": {
    "class_type": "SeedVR2LoadVAEModel",
    "inputs": {
      "model": "ema_vae_fp16.safetensors",
      "device": "cuda:0",
      "encode_tiled": true,
      "encode_tile_size": 512,
      "encode_tile_overlap": 64,
      "decode_tiled": true,
      "decode_tile_size": 512,
      "decode_tile_overlap": 64,
      "tile_debug": "false",
      "offload_device": "cpu",
      "cache_model": false
    },
    "_meta": {
      "title": "03 VAE · 分块编解码"
    }
  },
  "4": {
    "class_type": "SeedVR2VideoUpscaler",
    "inputs": {
      "seed": 42,
      "resolution": 2048,
      "max_resolution": 0,
      "batch_size": 1,
      "uniform_batch_size": false,
      "color_correction": "lab",
      "temporal_overlap": 0,
      "prepend_frames": 0,
      "input_noise_scale": 0,
      "latent_noise_scale": 0,
      "offload_device": "cpu",
      "enable_debug": false,
      "image": [
        "1",
        0
      ],
      "dit": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "04 SeedVR2 图像高清放大"
    }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "filename_prefix": "SeedVR2-2.5.1/高清放大"
    },
    "_meta": {
      "title": "05 保存高清PNG"
    }
  },
  "6": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "原图对照"
    }
  }
}
