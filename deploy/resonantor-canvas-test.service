[Unit]
Description=Resonantor isolated canvas test API
After=network.target

[Service]
Type=simple
User=resonantor-canvas-test
Group=resonantor-canvas-test
WorkingDirectory=/opt/web/resonantor-canvas/current
ExecStart=/opt/node-v22.14.0/bin/node /opt/web/resonantor-canvas/current/server/start-web-test.mjs
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
EnvironmentFile=-/etc/resonantor-canvas-test.env
StateDirectory=resonantor-canvas-test
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/resonantor-canvas-test

[Install]
WantedBy=multi-user.target
